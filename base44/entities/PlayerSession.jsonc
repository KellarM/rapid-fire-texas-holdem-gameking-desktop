{
  "name": "PlayerSession",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "player_slot": {
      "type": "number"
    },
    "balance": {
      "type": "number"
    },
    "rounds_played": {
      "type": "number"
    },
    "total_wagered": {
      "type": "number"
    },
    "total_returned": {
      "type": "number"
    },
    "session_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "last_active_at": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "device_id",
    "player_slot"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}